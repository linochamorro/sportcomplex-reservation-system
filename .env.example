# Variables requeridas (sin valores reales — completar en local/CI)
# Base de datos (Fase A-02)
DATABASE_URL=
DIRECT_URL=
# Pool de Postgres: tiempos y tamaño. Opcionales, con default sensato.
# DB_POOL_MAX=10            # conexiones por proceso; ajustarlo con datos, no a ojo
# DB_POOL_IDLE_MS=30000     # recicla antes de que el pooler corte la conexión
# DB_POOL_CONEXION_MS=8000  # falla rápido en vez de colgar la petición
# Sesión (Fase A-03)
JWT_SECRET=
# Clave compartida de cuentas de prueba QA/captura (scripts/crear-usuarios-prueba.mjs y
# scripts de captura): definir en el entorno con al menos 10 caracteres; no fijarla en código.
CLAVE_PRUEBA_QA=
# E2E (Playwright): global-setup genera claves aleatorias por corrida para las cuentas
# privilegiadas y las guarda en e2e/.semilla-e2e.json (temporal); no hay clave E2E fija.
# Cron interno (Fase B-05)
CRON_SECRET=
# Almacenamiento y correo (Fases B-04/B-05)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FRONTEND_URL=http://localhost:3000
